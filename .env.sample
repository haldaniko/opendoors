COMPOSE_PROJECT_NAME=opendoors

# Pin these tags/digests according to your update policy.
WORDPRESS_BASE_IMAGE=wordpress:php8.3-apache
WORDPRESS_IMAGE=opendoors-wordpress:latest
MYSQL_IMAGE=mysql:8.0.41
REDIS_IMAGE=redis:7.4-alpine
REDIS_MAXMEMORY=256mb

DEV_PORT=8080
# Production is expected to sit behind a TLS reverse proxy on the same host.
PROD_BIND_IP=127.0.0.1
PROD_PORT=8080
PROD_WP_URL=https://opendoors.center

DB_DATABASE=opendoors
DB_USER=opendoors
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password
DB_TABLE_PREFIX=wp_opendoors_
DB_SEED_FILE=./opendoors.sql.gz

# Generate unique values for production: https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=replace-with-a-unique-random-value
SECURE_AUTH_KEY=replace-with-a-unique-random-value
LOGGED_IN_KEY=replace-with-a-unique-random-value
NONCE_KEY=replace-with-a-unique-random-value
AUTH_SALT=replace-with-a-unique-random-value
SECURE_AUTH_SALT=replace-with-a-unique-random-value
LOGGED_IN_SALT=replace-with-a-unique-random-value
NONCE_SALT=replace-with-a-unique-random-value

WP_MEMORY_LIMIT=256M
WP_POST_REVISIONS=10
WP_AUTOSAVE_INTERVAL=60
WP_EMPTY_TRASH_DAYS=30
WP_REDIS_PREFIX=opendoors:
RECOVERY_MODE_EMAIL=admin@example.com
