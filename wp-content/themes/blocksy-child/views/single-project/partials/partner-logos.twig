{% if partner_logos or last_partner_logo or disclaimer_text %}
	<div class="wrapper-partner-logos d-flex flex-column flex-md-row align-items-start align-items-md-center gap-3 flex-wrap
			  {{ disclaimer_text ? 'has-disclaimer' : 'no-disclaimer justify-content-between' }}">
		{% if partner_logos %}
			<div class="d-flex flex-row align-items-center justify-content-center justify-content-md-start {{ disclaimer_text ? 'flex-nowrap' : 'flex-wrap' }} gap-3">
				{% for logo in partner_logos %}
					{% if logo.partner_logo %}
						<div class="wrapper-logo d-flex align-items-center justify-content-center">
							<img src="{{ logo.partner_logo }}" alt="Partner logo">
						</div>
					{% endif %}
				{% endfor %}

				{% if disclaimer_text %}
					<div class="text-center d-flex align-items-center">
						<p class="partner-logos-disclaimer mb-0 text-center">
							{{ disclaimer_text|e }}
						</p>
					</div>
				{% endif %}
			</div>
		{% endif %}

		{# Right: last logo aligned strictly to the right #}
		{% if last_partner_logo and last_partner_logo.partner_logo %}
			<div class="wrapper-logo partner-logo-last d-flex">
				<img src="{{ last_partner_logo.partner_logo }}" alt="Partner logo">
			</div>
		{% endif %}
	</div>
{% endif %}
